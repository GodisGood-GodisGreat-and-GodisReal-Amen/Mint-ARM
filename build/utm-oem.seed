# Unattended OEM install for the preinstalled UTM image (40-vm-image.sh).
# The temporary "oem" account only exists until the first boot: Mint's first-boot wizard
# (oem-config) asks for language, keyboard, time zone and the real user, then removes it.
d-i debian-installer/locale string en_US.UTF-8
d-i keyboard-configuration/layoutcode string us
d-i time/zone string Etc/UTC
d-i clock-setup/utc boolean true
d-i partman-auto/disk string /dev/vda
d-i partman-auto/method string regular
d-i partman-auto/choose_recipe select atomic
d-i partman-partitioning/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true
d-i user-setup/allow-password-weak boolean true
ubiquity ubiquity/use_nonfree boolean false
ubiquity ubiquity/download_updates boolean false
ubiquity ubiquity/reboot boolean false
ubiquity ubiquity/poweroff boolean true
d-i passwd/user-fullname string OEM Configuration (temporary user)
d-i passwd/username string oem
d-i passwd/user-password password oem
d-i passwd/user-password-again password oem
d-i oem-config/id string mint-arm
# After the install: prepare the first-boot wizard and lock the temporary account; give every
# copy of the VM its own machine ID and random seed; return unused blocks to the disk image.
ubiquity ubiquity/success_command string in-target oem-config-prepare --quiet; in-target passwd -l oem; truncate -s 0 /target/etc/machine-id; rm -f /target/var/lib/systemd/random-seed; fstrim /target || true
