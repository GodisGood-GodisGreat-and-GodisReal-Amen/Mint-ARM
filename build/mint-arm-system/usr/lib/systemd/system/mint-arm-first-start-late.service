[Unit]
Description=Linux Mint ARM: remove what this machine does not use, after the setup
Documentation=file:///usr/share/doc/mint-arm-system/README
ConditionPathExists=/var/lib/mint-arm/first-start-pending
# for looking at the image as it was built (tools/make-release.sh)
ConditionKernelCommandLine=!mint-arm.first-start=no
After=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/lib/mint-arm/first-start
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
