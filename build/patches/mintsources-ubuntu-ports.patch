 os.umask(0o022)
 
+# Ubuntu publishes every architecture other than amd64 and i386 on ports.ubuntu.com
+# ("ubuntu-ports"), including its security updates.
+DPKG_ARCH = subprocess.getoutput("dpkg --print-architecture").strip()
+USE_UBUNTU_PORTS = DPKG_ARCH not in ("amd64", "i386")
+UBUNTU_PORTS_MIRROR = "http://ports.ubuntu.com/ubuntu-ports"
+UBUNTU_PORTS_MIRRORS_FILE = "/usr/share/mintsources/ubuntu-ports.mirrors"
+
+def adjust_for_ubuntu_ports(template):
+    if USE_UBUNTU_PORTS:
+        template = template.replace("http://security.ubuntu.com/ubuntu/", UBUNTU_PORTS_MIRROR + "/")
+    return template
+
 def signal_handler(signum, _):
